# Example keystore configuration for Play Store production release builds.
# Copy this file to `android/key.properties` and fill in your actual keystore credentials.
# `android/key.properties` is git-ignored to keep your release signing secret safe.
#
# Generate a release keystore using:
# keytool -genkey -v -keystore android/app/cremenkart-release-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storePassword=your_keystore_password_here
keyPassword=your_key_password_here
keyAlias=upload
storeFile=cremenkart-release-upload.jks
